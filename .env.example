# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in your values.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development          # "development" | "production"
PORT=5000
SECRET_KEY=replace_with_random_string_at_least_32_chars
ALLOWED_ORIGINS=http://localhost:3000

# ── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_a_random_string_32_chars_min
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=30

# ── Default admin (created on first startup if no admin exists) ──────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, zero config — file created automatically):
DATABASE_URL=sqlite:///cyberguard.db
# MySQL alternative:
# DATABASE_URL=mysql+mysqlconnector://user:password@localhost/cyberguard
# PostgreSQL alternative:
# DATABASE_URL=postgresql://user:password@localhost/cyberguard

# ── ML model selection ────────────────────────────────────────────────────
# Set to "true" to use a HuggingFace transformer instead of sklearn.
# Requires torch + transformers installed and HF_TOKEN set below.
USE_TRANSFORMER=true

# ── Meta (Facebook / Instagram) ───────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
META_WEBHOOK_VERIFY_TOKEN=any_custom_string_you_choose

# ── HuggingFace (only needed when USE_TRANSFORMER=true) ───────────────────
HF_TOKEN=hf_asdasdasdadadadadadasd
# Available models (auto-selected per language in lang_detector.py):
#   unitary/toxic-bert                                        — English (default for HF_MODEL)
#   gravitee-io/distilbert-multilingual-toxicity-classifier    — 14 languages (ar, hi, fr, de, es, etc.)
#   Hate-speech-CNERG/urdu-abusive-MuRIL                      — Urdu (native + Roman script)
HF_MODEL=unitary/toxic-bert

# ── Multilingual model routing ────────────────────────────────────────────
# Per-language model overrides are configured in backend/models/lang_detector.py
# DEFAULT_LANG_MODEL is the fallback for unmapped languages
DEFAULT_LANG_MODEL=gravitee-io/distilbert-multilingual-toxicity-classifier

# NOTE: The ML stack uses PyTorch (torch), NOT TensorFlow.
# Do not install tensorflow — it is not used by this project.

# ── Redis (for Celery background tasks) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
